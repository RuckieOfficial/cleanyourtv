<?xml version="1.0" encoding="utf-8"?>
<!-- Soft dark gradient for the left side and top, keeping movie text, clock and UI elements crisp and readable over light wallpapers -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#B8040508"
        android:centerColor="#52040508"
        android:endColor="#1E040508"
        android:centerX="0.45" />
</shape>
