<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): clock and date that drift around a black screen over an ambient glow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:id="@+id/clockTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#E6F2F7FA"
                android:textSize="140sp"
                android:shadowColor="#80FFFFFF"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="16"
                android:fontFamily="@string/font_light"
                android:letterSpacing="-0.03"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#80FFFFFF"
                android:textSize="24sp"
                android:shadowColor="#4DFFFFFF"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="8"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#80E2E8F0"
            android:textSize="20sp"
            android:shadowColor="#40FFFFFF"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:fontFamily="@string/font_regular"
            android:letterSpacing="0.12"
            android:textAllCaps="true" />
    </LinearLayout>
</FrameLayout>
